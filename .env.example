# 必須
SESSION_SECRET=          # openssl rand -base64 32
BASE_URL=http://localhost:8787

# 本番（Neon）。必ず pooled 接続（ホスト名に -pooler が入るもの）を使う。
# 未設定ならローカルの PGlite にフォールバックする。
DATABASE_URL=
# PGlite のデータ置き場。未設定ならメモリ（プロセス終了で消える）。
PGLITE_DIR=./data/pg

PORT=8787

# 決済（未設定ならFreeプランのみ動作する）
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Notion 連携（未設定なら連携メニューを出さない）
# Notion の Integrations で Public integration を作り、Redirect URI に
# <BASE_URL>/app/connect/notion/callback を登録して取得する。
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# 特定商取引法に基づく表記（日本で有料販売する場合は法令上必須）
LEGAL_SELLER_NAME=
LEGAL_REPRESENTATIVE=
LEGAL_ADDRESS=
LEGAL_PHONE=
LEGAL_EMAIL=
